# Règles de mise en forme partagées par les éditeurs de code
# (VS Code les applique avec l'extension « EditorConfig »).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# En Markdown, deux espaces en fin de ligne forcent un retour à la ligne :
# on ne les supprime donc pas automatiquement.
trim_trailing_whitespace = false
