    "gray-matter": "^4.0.3",
    "html-validate": "^11.16.2",
    "jsdom": "^30.1.2",
    "marked": "^18.0.14",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "vite": "^8.3.1"
  }
}
