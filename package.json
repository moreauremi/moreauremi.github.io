{
  "name": "remios-portfolio",
  "private": true,
  "version": "0.1.0",
  "description": "RémiOS — portfolio BTS SIO SISR de Rémi Moreau, façon démarrage Linux",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
